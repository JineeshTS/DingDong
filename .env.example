# Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control

# Environment
ENVIRONMENT=development

# API Configuration
API_BASE_URL=https://api.dingdong.app/v1
API_TIMEOUT=30

# Firebase Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id

# Google Services
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_VISION_API_KEY=your-google-vision-api-key

# Apple Sign In
APPLE_SERVICE_ID=your-apple-service-id
APPLE_REDIRECT_URI=your-redirect-uri

# Microsoft OAuth
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# OpenAI (for AI features)
OPENAI_API_KEY=your-openai-api-key
OPENAI_ORG_ID=your-openai-org-id

# Azure Computer Vision (backup AI)
AZURE_VISION_API_KEY=your-azure-vision-key
AZURE_VISION_ENDPOINT=your-azure-vision-endpoint

# RevenueCat (Subscriptions)
REVENUECAT_API_KEY_IOS=your-ios-api-key
REVENUECAT_API_KEY_ANDROID=your-android-api-key

# Stripe (Payments)
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_SECRET_KEY=your-stripe-secret-key

# Sentry (Error Tracking)
SENTRY_DSN=your-sentry-dsn

# Mixpanel (Analytics)
MIXPANEL_TOKEN=your-mixpanel-token

# Feature Flags
ENABLE_AI_IMAGE_RECOGNITION=true
ENABLE_VOICE_INPUT=true
ENABLE_LOCATION_REMINDERS=true
ENABLE_BIOMETRIC_AUTH=true
ENABLE_ANALYTICS=true
ENABLE_CRASH_REPORTING=true

# Debug Settings
DEBUG_MODE=true
SHOW_DEBUG_LOGS=true
ENABLE_PERFORMANCE_OVERLAY=false
